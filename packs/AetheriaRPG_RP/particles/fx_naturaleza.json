{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "rpg:fx_naturaleza",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/rpg_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 14
      },
      "minecraft:emitter_shape_disc": {
        "radius": 0.9,
        "offset": [
          0,
          1.2,
          0
        ],
        "plane_normal": "y",
        "direction": [
          0,
          -1,
          0
        ]
      },
      "minecraft:particle_initial_speed": 0.3,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "1.1 + v.particle_random_1 * 0.6"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin(v.particle_age * 400 + v.particle_random_3 * 360) * 2.5",
          -1.4,
          "math.cos(v.particle_age * 300 + v.particle_random_3 * 360) * 1.5"
        ],
        "linear_drag_coefficient": 1.6
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.05,
        "collision_drag": 10
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-200, 200)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.08 + v.particle_random_4 * 0.04",
          "0.08 + v.particle_random_4 * 0.04"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            "v.particle_random_2 < 0.25 ? 112 : 96",
            16
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "0.85 + v.particle_random_3 * 0.15",
          "0.9 + v.particle_random_3 * 0.1",
          "0.8",
          "1 - math.pow(v.particle_age / v.particle_lifetime, 6)"
        ]
      }
    }
  }
}
