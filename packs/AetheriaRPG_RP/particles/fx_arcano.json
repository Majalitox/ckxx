{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "rpg:fx_arcano",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/rpg_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 8
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.9 + v.particle_random_1 * 0.3"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos(v.particle_age * 260 + v.particle_random_2 * 360) * (0.9 - v.particle_age * 0.3)",
          "v.particle_age * 0.7 - 0.2 + v.particle_random_3 * 0.4",
          "math.sin(v.particle_age * 260 + v.particle_random_2 * 360) * (0.9 - v.particle_age * 0.3)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.12 + 0.03 * math.sin(v.particle_age * 900)",
          "0.12 + 0.03 * math.sin(v.particle_age * 900)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            "0 + math.floor(v.particle_random_4 * 4 * 0.999) * 16",
            32
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.00": [
              1.0,
              1.0,
              1.0,
              1.0
            ],
            "0.30": [
              0.941,
              0.627,
              1.0,
              1.0
            ],
            "1.00": [
              0.627,
              0.251,
              1.0,
              1.0
            ]
          },
          "interpolant": "(v.particle_age / v.particle_lifetime)"
        }
      }
    }
  }
}
