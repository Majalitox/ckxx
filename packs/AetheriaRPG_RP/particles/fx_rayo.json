{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "rpg:fx_rayo",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/rpg_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 12
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.35,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "v.particle_random_1 < 0.5 ? 0.3 : 5",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.12 + v.particle_random_2 * 0.2"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 7
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.particle_random_1 < 0.5 ? 0.3 + v.particle_random_3 * 0.2 : 0.06",
          "v.particle_random_1 < 0.5 ? 0.3 + v.particle_random_3 * 0.2 : 0.06"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            "v.particle_random_1 < 0.5 ? (v.particle_random_4 < 0.5 ? 0 : 16) : 16",
            "v.particle_random_1 < 0.5 ? 16 : 0"
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "1",
          "0.95 + v.particle_random_3 * 0.05",
          "0.55 + v.particle_random_3 * 0.45",
          "math.mod(math.floor(v.particle_age * 40), 2) == 0 ? 1 : 0.45"
        ]
      }
    }
  }
}
