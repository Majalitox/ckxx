{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "rpg:zzz",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/rpg_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 1.4
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 2.2,
        "max_particles": 4
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          0.35,
          1,
          0.15
        ]
      },
      "minecraft:particle_initial_speed": 0.32,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1.7
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin(v.particle_age * 300) * 0.3",
          0.05,
          0
        ]
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(-15, 15)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.07 + (v.particle_age / v.particle_lifetime) * 0.12",
          "0.07 + (v.particle_age / v.particle_lifetime) * 0.12"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            64,
            48
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "math.min((v.particle_age / v.particle_lifetime) * 6, 1) * math.clamp(1 - math.pow(v.particle_age / v.particle_lifetime, 2), 0, 1)"
        ]
      }
    }
  }
}
