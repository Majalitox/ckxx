{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "rpg:fx_tierra",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/rpg_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 16
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.4,
        "direction": [
          "math.random(-1, 1)",
          "math.random(0.8, 1.8)",
          "math.random(-1, 1)"
        ]
      },
      "minecraft:particle_initial_speed": "v.particle_random_1 < 0.35 ? 0.6 : 2.6 + v.particle_random_2 * 1.2",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.particle_random_1 < 0.35 ? 1.0 : 0.9 + v.particle_random_2 * 0.4"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          "v.particle_random_1 < 0.35 ? 0.3 : -16",
          0
        ],
        "linear_drag_coefficient": "v.particle_random_1 < 0.35 ? 2 : 0.3"
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.08,
        "coefficient_of_restitution": 0.25,
        "collision_drag": 4
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-300, 300)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.particle_random_1 < 0.35 ? 0.3 : 0.07 + v.particle_random_3 * 0.06",
          "v.particle_random_1 < 0.35 ? 0.3 : 0.07 + v.particle_random_3 * 0.06"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            "v.particle_random_1 < 0.35 ? 96 : 80",
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "0.55 + v.particle_random_4 * 0.2",
          "0.38 + v.particle_random_4 * 0.15",
          "0.2 + v.particle_random_4 * 0.1",
          "v.particle_random_1 < 0.35 ? 0.55 * math.clamp(1 - math.pow(v.particle_age / v.particle_lifetime, 2), 0, 1) : 1 - math.pow((v.particle_age / v.particle_lifetime), 6)"
        ]
      }
    }
  }
}
