{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "rpg:fx_necromancia",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/rpg_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 12
      },
      "minecraft:emitter_shape_disc": {
        "radius": 0.6,
        "plane_normal": "y",
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_initial_speed": "0.5 + v.particle_random_2 * 0.6",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.9 + v.particle_random_1 * 0.5"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin(v.particle_age * 700 + v.particle_random_3 * 360) * 3",
          0.9,
          "math.cos(v.particle_age * 700 + v.particle_random_3 * 360) * 3"
        ],
        "linear_drag_coefficient": 1.4
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.1 + v.particle_random_3 * 0.06",
          "0.16 + v.particle_random_3 * 0.08"
        ],
        "facing_camera_mode": "lookat_y",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            80,
            16
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.00": [
              0.847,
              1.0,
              0.878,
              1.0
            ],
            "0.30": [
              0.376,
              1.0,
              0.565,
              1.0
            ],
            "0.75": [
              0.125,
              0.627,
              0.314,
              1.0
            ],
            "1.00": [
              0.039,
              0.188,
              0.094,
              1.0
            ]
          },
          "interpolant": "(v.particle_age / v.particle_lifetime)"
        }
      }
    }
  }
}
