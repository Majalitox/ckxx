{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "rpg:orb",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/rpg_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 3
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.16
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.particle_random_1 < 0.34 ? 0.1 : (v.particle_random_1 < 0.67 ? 0.2 : 0.32)",
          "v.particle_random_1 < 0.34 ? 0.1 : (v.particle_random_1 < 0.67 ? 0.2 : 0.32)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.color.r ?? 1) + (1 - (v.color.r ?? 1)) * (v.particle_random_1 < 0.34 ? 0.75 : 0)",
          "(v.color.g ?? 1) + (1 - (v.color.g ?? 1)) * (v.particle_random_1 < 0.34 ? 0.75 : 0)",
          "(v.color.b ?? 1) + (1 - (v.color.b ?? 1)) * (v.particle_random_1 < 0.34 ? 0.75 : 0)",
          "(v.particle_random_1 < 0.67 ? 1 : 0.55) * (1 - (v.particle_age / v.particle_lifetime) * 0.5)"
        ]
      }
    }
  }
}
