{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "rpg:circle",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/rpg_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1.1
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": 40
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "1.35 + (v.particle_age / v.particle_lifetime) * 0.35",
          "1.35 + (v.particle_age / v.particle_lifetime) * 0.35"
        ],
        "facing_camera_mode": "emitter_transform_xz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            0,
            64
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.color.r ?? 1",
          "v.color.g ?? 1",
          "v.color.b ?? 1",
          "math.clamp(math.min((v.particle_age / v.particle_lifetime) * 8, 1) * (1 - math.pow((v.particle_age / v.particle_lifetime), 3)) * 0.9, 0, 1)"
        ]
      }
    }
  }
}
