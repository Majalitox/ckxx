          "(0.09 + v.particle_random_3 * 0.08) * (1 - v.particle_age / v.particle_lifetime) + 0.02",
          "(0.13 + v.particle_random_3 * 0.1) * (1 - v.particle_age / v.particle_lifetime) + 0.02"
        ],
        "facing_camera_mode": "lookat_y",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            48,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.00": [
              1.0,
              0.965,
              0.69,
              1.0
            ],
            "0.25": [
              1.0,
              0.69,
              0.188,
              1.0
            ],
            "0.60": [
              0.941,
              0.251,
              0.063,
              1.0
            ],
            "1.00": [
              0.227,
              0.165,
              0.157,
              1.0
            ]
          },
          "interpolant": "(v.particle_age / v.particle_lifetime)"
        }
      }
    }
  }
