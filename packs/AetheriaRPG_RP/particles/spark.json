{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "rpg:spark",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/rpg_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "math.random(-1, 1)",
          "math.random(-0.2, 1)",
          "math.random(-1, 1)"
        ]
      },
      "minecraft:particle_initial_speed": 0.35,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.35 + v.particle_random_1 * 0.3"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 2.5,
        "linear_acceleration": [
          0,
          0.4,
          0
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.05 + v.particle_random_3 * 0.05) * (1 - v.particle_age / v.particle_lifetime) + 0.02",
          "(0.05 + v.particle_random_3 * 0.05) * (1 - v.particle_age / v.particle_lifetime) + 0.02"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            "0 + math.floor(v.particle_random_2 * 2 * 0.999) * 16",
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.color.r ?? 1",
          "v.color.g ?? 1",
          "v.color.b ?? 1",
          "math.clamp(1 - math.pow(v.particle_age / v.particle_lifetime, 2), 0, 1)"
        ]
      }
    }
  }
}
