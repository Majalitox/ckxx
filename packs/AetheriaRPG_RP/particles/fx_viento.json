{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "rpg:fx_viento",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/rpg_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 20
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.7 + v.particle_random_1 * 0.3"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos(v.particle_age * 600 + v.particle_random_2 * 360) * (0.35 + v.particle_age * 1.1)",
          "v.particle_age * 2.0 + v.particle_random_3 * 0.3 - 0.4",
          "math.sin(v.particle_age * 600 + v.particle_random_2 * 360) * (0.35 + v.particle_age * 1.1)"
        ]
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": 400
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.13 + v.particle_random_3 * 0.08",
          "0.13 + v.particle_random_3 * 0.08"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            112,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.00": [
              1.0,
              1.0,
              1.0,
              1.0
            ],
            "0.50": [
              0.847,
              1.0,
              0.91,
              1.0
            ],
            "1.00": [
              0.659,
              0.91,
              0.784,
              1.0
            ]
          },
          "interpolant": "(v.particle_age / v.particle_lifetime)"
        }
      }
    }
  }
}
