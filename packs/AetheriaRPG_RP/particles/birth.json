{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "rpg:birth",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/rpg_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 2
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.12,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": 0.25,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.6 + v.particle_random_1 * 0.5"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.35,
          0
        ],
        "linear_drag_coefficient": 1.5
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 90)",
        "rotation_rate": 90
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.05 + v.particle_random_3 * 0.05) * (0.6 + 0.4 * math.sin(v.particle_age * 1500 + v.particle_random_4 * 360))",
          "(0.05 + v.particle_random_3 * 0.05) * (0.6 + 0.4 * math.sin(v.particle_age * 1500 + v.particle_random_4 * 360))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            16,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.color.r ?? 1) * 0.7 + 0.3",
          "(v.color.g ?? 1) * 0.7 + 0.3",
          "(v.color.b ?? 1) * 0.7 + 0.3",
          "math.clamp(1 - math.pow(v.particle_age / v.particle_lifetime, 2), 0, 1)"
        ]
      }
    }
  }
}
