{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": {
      "identifier": "rpg:orc",
      "population_control": "monster"
    },
    "conditions": [
      {
        "minecraft:weight": {
          "default": 18
        },
        "minecraft:herd": {
          "min_size": 1,
          "max_size": 3
        },
        "minecraft:difficulty_filter": {
          "min": "easy",
          "max": "hard"
        },
        "minecraft:biome_filter": {
          "any_of": [
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "savanna"
            },
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "mesa"
            },
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "plains"
            },
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "rpg_cursed"
            }
          ]
        },
        "minecraft:spawns_on_surface": {}
      }
    ]
  }
}
